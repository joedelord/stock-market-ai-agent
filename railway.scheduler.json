{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "npm run market:watch",
    "numReplicas": 1,
    "overlapSeconds": 0,
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 25
  }
}
