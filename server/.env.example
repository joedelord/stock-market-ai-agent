PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=your_database

# Alternative to the DB_* variables above, as given by hosted providers.
# DATABASE_URL=postgres://user:password@host:5432/database

# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
COOKIE_EXPIRES_IN_MS=3600000

# Address users open in the browser; email links are built from it.
# Required in production.
CLIENT_ORIGIN=http://localhost:5173

# Production only: serve the built client (client/dist) from this server.
# The Docker image sets it. CLIENT_DIST_DIRECTORY overrides the location.
# SERVE_CLIENT=true

# debug, info, warn, error or silent. Defaults to info (silent in tests).
# LOG_LEVEL=info

# Market data provider, used by services/marketDataService.js.
TWELVE_DATA_API_KEY=your_twelve_data_api_key
# Comma-separated MIC codes of the exchanges to fetch, search and show.
# Supported: XNAS, XNYS, XHEL. Defaults to the US exchanges, because Twelve
# Data's Basic plan does not cover Helsinki. Unknown codes stop the server.
ENABLED_EXCHANGES=XNAS,XNYS
# Most active stocks admins can add. Each followed stock uses about 34
# Twelve Data requests per trading day; the free plan allows about 800.
# MAX_ACTIVE_STOCKS=20

# AI analysis provider, used by services/groqService.js.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
# Optional. "none" turns off reasoning so answers fit the token limit.
# Allowed values depend on the model; leave unset if unsure.
GROQ_REASONING_EFFORT=none

# Email delivery, used by services/emailService.js. Locally, Mailpit listens on
# port 1025 (web UI on http://localhost:8025). Without SMTP_HOST, development
# only logs emails. Production requires MAIL_FROM and either SMTP_HOST or the
# GMAIL_* variables below. SMTP_USER and SMTP_PASS are only needed by real providers.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Stock Market AI <notifications@example.com>"

# Free option without your own domain: send through a Gmail account. Needs
# 2-Step Verification and an app password (myaccount.google.com/apppasswords),
# not the account password. MAIL_FROM must match SMTP_USER, or Gmail rewrites it.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=your_16_char_app_password
# MAIL_FROM="Stock Market AI <your.account@gmail.com>"

# Gmail over HTTPS instead of SMTP, for hosts that block SMTP (e.g. Railway's
# Trial and Hobby plans). When all three are set, they replace the SMTP_*
# settings. See the Email section of the README for getting the refresh token.
# MAIL_FROM must be the Gmail address that authorized the token.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Optional. Company news from Marketaux, fetched only for significant day
# moves (twice the stock's typical daily move, or 3% with little history).
# Without a key, the analysis says news is not configured.
# MARKETAUX_API_KEY=
